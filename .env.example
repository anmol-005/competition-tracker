# Competition Tracker Environment Configuration
# Copy this file to .env and update with your actual values

# ===== GOOGLE AI CONFIGURATION =====
# Get your API key from Google AI Studio: https://makersuite.google.com/app/apikey
API=your_google_ai_api_key_here

# ===== MONGODB CONFIGURATION =====
# Choose one of the following options:

# Option 1: MongoDB Atlas (Cloud - Recommended for production/team)
# Create free cluster at https://www.mongodb.com/atlas
MONGODB_USERNAME=your_atlas_username
MONGODB_PASSWORD=your_atlas_password
MONGODB_CLUSTER=your-cluster-name.xxxxx.mongodb.net
DATABASE_NAME=competition_tracker

# Leave MONGODB_URL empty when using Atlas credentials above
MONGODB_URL=

# Option 2: Direct MongoDB URL (Alternative)
# Uncomment and use this if you prefer direct connection string
# MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/competition_tracker

# Option 3: Local MongoDB (Development only)
# MONGODB_URL=mongodb://localhost:27017/competition_tracker

# ===== DATABASE SETTINGS =====
DB_POOL_SIZE=10
DB_TIMEOUT=30

# Data Retention (in days)
PRICE_HISTORY_RETENTION=365
SCRAPING_LOGS_RETENTION=30
ANALYTICS_CACHE_RETENTION=1

# ===== SCRAPING CONFIGURATION =====
AMAZON_SCRAPING_INTERVAL=24      # hours between scraping runs
SMARTPRIX_SCRAPING_INTERVAL=12   # hours between scraping runs
FLIPKART_SCRAPING_INTERVAL=24    # hours between scraping runs
MAX_CONCURRENT_REQUESTS=5        # simultaneous requests
REQUEST_DELAY=1.0                # seconds between requests
MAX_RETRIES=3                    # retry failed requests
RETRY_DELAY=5                    # seconds before retry
MIN_DATA_QUALITY_SCORE=0.7       # minimum quality threshold

# ===== AI & ANALYTICS CONFIGURATION =====
PRICE_ALERT_THRESHOLD=10.0       # percentage change for alerts
SIGNIFICANT_PRICE_DROP=15.0      # percentage for significant drops
ANALYTICS_REFRESH_INTERVAL=6     # hours between analytics updates
COMPETITOR_ANALYSIS_INTERVAL=12  # hours between competitor analysis
TOP_COMPETITORS_LIMIT=20         # number of top competitors to track
PRICE_TREND_DAYS=30             # days for price trend analysis

# ===== WEB APPLICATION SETTINGS =====
# LabXpert frontend configuration
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false

# CORS Settings (allowed origins for frontend)
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://localhost:5000"]

# ===== SECURITY SETTINGS =====
# JWT Authentication (generate a secure secret key)
SECRET_KEY=your_jwt_secret_key_here_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Session Security
SESSION_SECRET=your_session_secret_key_here

# ===== LOGGING CONFIGURATION =====
LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json                  # json or text
LOG_FILE=logs/competition_tracker.log

# ===== DEVELOPMENT FLAGS =====
DEVELOPMENT=true
DEBUG_SCRAPERS=false
ENABLE_RATE_LIMITING=true